---
import { Image } from 'astro:assets';
import { stories, characters, bySlug, coverOf, posterOf, nameOf, inkOf, type Story } from '../lib/content';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** show only stories with this character; hides the filter */
  only?: string;
  items?: Story[];
}
const { lang, only, items } = Astro.props;
const s = t(lang);
const list = items ?? (only ? stories.filter((st) => st.cast.includes(only)) : stories);
const castSlugs = [...new Set(list.flatMap((st) => st.cast))];
const filterable = !only && list.length > 1;
---

<div class="stories" data-stories>
  {filterable && (
    <div class="filters" role="group" aria-label={s.storiesSub}>
      <button class="chip is-on" data-filter="" aria-pressed="true">{s.filterAll}</button>
      {characters
        .filter((c) => castSlugs.includes(c.slug))
        .map((c) => (
          <button
            class="chip"
            data-filter={c.slug}
            aria-pressed="false"
            style={`--accent:${c.accent};--accent-ink:${inkOf(c.accent)};`}
          >
            {nameOf(c, lang)}
          </button>
        ))}
    </div>
  )}

  {list.length === 0 && <p class="empty">{only ? s.noStories : s.storiesEmpty}</p>}

  <ul class="list">
    {list.map((st) => {
      const cover = coverOf(st.slug);
      return (
        <li data-cast={st.cast.join(' ')}>
          <a class="story" href={`/${lang}/stories/${st.slug}/`}>
            <div class="cover">
              {cover ? (
                <Image src={cover} alt="" widths={[480, 800]} sizes="(max-width: 700px) 100vw, 420px" loading="lazy" />
              ) : (
                <div class="nocover" />
              )}
            </div>
            <div class="body">
              <h3>{st.title}</h3>
              <p class="excerpt">{st.excerpt}</p>
              <div class="cast" aria-label={s.cast}>
                {st.cast.map((slug) => {
                  const c = bySlug[slug];
                  const p = c && posterOf(slug);
                  return (
                    c && (
                      <span class="avatar" style={`--accent:${c.accent};`} title={nameOf(c, lang)}>
                        {p && <Image src={p} alt={nameOf(c, lang)} width={64} height={64} loading="lazy" />}
                      </span>
                    )
                  );
                })}
              </div>
              <span class="date">{st.date}</span>
            </div>
          </a>
        </li>
      );
    })}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-stories]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = root.querySelectorAll<HTMLElement>('[data-cast]');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter ?? '';
        buttons.forEach((x) => {
          const on = x === b;
          x.classList.toggle('is-on', on);
          x.setAttribute('aria-pressed', String(on));
        });
        items.forEach((li) => {
          li.hidden = Boolean(f) && !(li.dataset.cast ?? '').split(' ').includes(f);
        });
      }),
    );
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .filters .chip {
    border: 2px solid transparent;
    cursor: pointer;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 700;
  }
  .filters .chip.is-on {
    border-color: var(--accent-ink);
  }
  .empty {
    color: var(--ink-2);
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
  }
  .story {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 1.5rem;
    background: var(--panel);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
    box-shadow: var(--shadow-sm);
  }
  .story:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .cover {
    aspect-ratio: 4 / 3;
    background: var(--panel-2);
  }
  .cover img,
  .nocover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .body {
    padding: 1.25rem 1.5rem 1.25rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .excerpt {
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .cast {
    display: flex;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    overflow: hidden;
    border: 2px solid var(--panel);
    background: color-mix(in srgb, var(--accent) 40%, var(--panel));
    margin-left: -8px;
  }
  .avatar:first-child {
    margin-left: 0;
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .date {
    font-size: 0.8rem;
    color: var(--ink-3);
    font-weight: 700;
  }
  @media (max-width: 700px) {
    .story {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .body {
      padding: 1rem 1.25rem 1.25rem;
    }
  }
</style>
