---
import { Image } from 'astro:assets';
import { sceneMeta, sceneOf, places, placeName, storiesAt } from '../lib/content';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const map = sceneOf('Kindergarten-Map');
const mapMeta = sceneMeta.find((r) => r.file === 'Kindergarten-Map');
const countLabel = (n: number) => `${n} ${n === 1 ? s.storyCount.one : s.storyCount.many}`;
---

<div class="places">
  <ul class="strip" tabindex="0">
    {places.map((r) => {
      const img = sceneOf(r.file);
      const n = storiesAt(r.file).length;
      return (
        img && (
          <li>
            <a class="place" href={`/${lang}/places/${r.slug}/`}>
              <span class="pic">
                <Image src={img} alt={placeName(r, lang)} widths={[480, 720]} sizes="360px" loading="lazy" />
                {n > 0 && <span class="count">{countLabel(n)}</span>}
              </span>
              <span class="name">{placeName(r, lang)}</span>
            </a>
          </li>
        )
      );
    })}
  </ul>
  {map && (
    <figure class="map">
      <Image
        src={map}
        alt={mapMeta ? placeName(mapMeta, lang) : ''}
        widths={[800, 1200, 1600]}
        sizes="(max-width: 1240px) 100vw, 1200px"
        loading="lazy"
      />
    </figure>
  )}
</div>

<style>
  .strip {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0 0 0.75rem;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }
  .strip li {
    flex: 0 0 min(360px, 78vw);
    scroll-snap-align: start;
  }
  .place {
    display: block;
    color: inherit;
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .pic {
    position: relative;
    display: block;
    border-radius: var(--radius-sm);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s ease;
  }
  .pic img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .count {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--ink);
    background: rgba(250, 244, 239, 0.92);
    padding: 0.2em 0.65em;
    border-radius: 999px;
  }
  .name {
    display: block;
    margin-top: 0.5rem;
    font-weight: 700;
    color: var(--ink-2);
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }
  .place:hover .pic,
  .place:focus-visible .pic {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .place:hover .pic img {
    transform: scale(1.04);
  }
  .place:hover .name,
  .place:focus-visible .name {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .place:focus-visible {
    outline: 2px solid var(--ink-2);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .pic,
    .pic img {
      transition: none;
    }
    .place:hover .pic,
    .place:hover .pic img {
      transform: none;
    }
  }
  .map {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
</style>
