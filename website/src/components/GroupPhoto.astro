---
import { Image } from 'astro:assets';
import { groupPhoto, groupLayers, bySlug, nameOf, inkOf } from '../lib/content';
import { nameToSlug } from '../data/characters.config.mjs';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const spots = groupLayers
  .map((l) => ({ ...l, slug: (nameToSlug as Record<string, string>)[l.character] }))
  .filter((l) => l.slug && bySlug[l.slug]);
---

<figure class="photo">
  {groupPhoto && (
    <Image
      src={groupPhoto}
      alt={s.hero.alt}
      widths={[720, 1200, 1600, 2000]}
      sizes="(max-width: 1240px) 100vw, 1200px"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <ul class="spots" aria-label={s.charactersTitle}>
    {spots.map((p) => {
      const c = bySlug[p.slug];
      return (
        <li style={`left:${p.x * 100}%;top:${p.y * 100}%;--accent:${c.accent};--accent-ink:${inkOf(c.accent)};`}>
          <a href={`/${lang}/characters/${c.slug}/`} aria-label={nameOf(c, lang)}>
            <span class="dot" />
            <span class="label">{nameOf(c, lang)}</span>
          </a>
        </li>
      );
    })}
  </ul>
  <figcaption>{s.hero.hint}</figcaption>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--panel-2);
  }
  .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .spots {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .spots li {
    position: absolute;
    transform: translate(-50%, -50%);
  }
  .spots a {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem;
    border-radius: 999px;
  }
  .dot {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--accent);
    border: 3px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .label {
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--ink);
    background: rgba(255, 250, 246, 0.95);
    padding: 0.15em 0.6em;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }
  .spots a:hover .dot,
  .spots a:focus-visible .dot {
    transform: scale(1.3);
  }
  .spots a:hover .label,
  .spots a:focus-visible .label {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .label {
      opacity: 1;
      transform: none;
    }
    .dot {
      width: 12px;
      height: 12px;
    }
    .label {
      font-size: 0.7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dot,
    .label {
      transition: none;
    }
  }
  figcaption {
    position: absolute;
    right: 0.9rem;
    bottom: 0.7rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-2);
    background: rgba(250, 244, 239, 0.9);
    padding: 0.2em 0.7em;
    border-radius: 999px;
  }
  @media (max-width: 640px) {
    figcaption {
      display: none;
    }
    /* mobile crop keeps the centre; edge characters (QC, 点儿, whiskle) are meant to be cut (GROUP-PHOTO.md) */
    .photo img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
