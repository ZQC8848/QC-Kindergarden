---
import { Image } from 'astro:assets';
import { groupPhoto, groupLayers, bySlug, nameOf, onAccent } from '../lib/content';
import { nameToSlug } from '../data/characters.config.mjs';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const spots = groupLayers
  .map((l) => ({ ...l, slug: (nameToSlug as Record<string, string>)[l.character] }))
  .filter((l) => l.slug && bySlug[l.slug]);
---

<figure class="photo" data-group-photo>
  <div class="canvas">
  {groupPhoto && (
    <Image
      src={groupPhoto}
      alt={s.hero.alt}
      widths={[720, 1200, 1600, 2000]}
      sizes="(max-width: 1240px) 100vw, 1200px"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <ul class="spots" aria-label={s.charactersTitle}>
    {spots.map((p, i) => {
      const c = bySlug[p.slug];
      const at = p.spot ?? { x: p.x, y: p.y };
      return (
        <li style={`left:${at.x * 100}%;top:${at.y * 100}%;--i:${i};--accent:${c.accent};--on-accent:${onAccent(c.accent)};`}>
          <a href={`/${lang}/characters/${c.slug}/`} aria-label={nameOf(c, lang)}>
            <span class="dot" />
            <span class="label">{nameOf(c, lang)}</span>
          </a>
        </li>
      );
    })}
  </ul>
  </div>
  <figcaption>{s.hero.hint}</figcaption>
</figure>

<script>
  // On narrow screens the canvas is wider than the frame and scrolls sideways.
  // Start centred so the first view matches the old centre crop.
  document.querySelectorAll<HTMLElement>('[data-group-photo]').forEach((el) => {
    const centre = () => {
      const extra = el.scrollWidth - el.clientWidth;
      if (extra > 0) el.scrollLeft = extra / 2;
    };
    centre();
    window.addEventListener('resize', centre, { passive: true });
  });
</script>

<style>
  .photo {
    position: relative;
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: var(--panel-2);
  }
  .canvas {
    position: relative;
    width: 100%;
  }
  .canvas img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .spots {
    list-style: none;
    margin: 0;
    padding: 0;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Dots and name tags stay hidden until the pointer is over the photo (or a dot has focus). */
  .spots li {
    position: absolute;
    transform: translate(-50%, -50%);
    opacity: 0;
    transition: opacity 0.25s ease;
    transition-delay: calc(var(--i, 0) * 25ms);
  }
  .photo:hover .spots li,
  .photo:focus-within .spots li {
    opacity: 1;
  }
  .spots a {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem;
    border-radius: 999px;
  }
  .dot {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--accent);
    border: 3px solid rgba(255, 255, 255, 0.95);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .label {
    font-weight: 800;
    font-size: 0.85rem;
    color: var(--ink);
    background: rgba(255, 250, 246, 0.95);
    padding: 0.15em 0.6em;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    transition: background 0.2s ease;
    white-space: nowrap;
  }
  .spots a:hover .dot,
  .spots a:focus-visible .dot {
    transform: scale(1.3);
  }
  .spots a:hover .label,
  .spots a:focus-visible .label {
    background: var(--accent);
    color: var(--on-accent);
  }
  @media (hover: none) {
    /* Touch screens: dots only, always visible, with a bigger tap target. */
    .spots li {
      opacity: 1;
      transition: none;
    }
    .spots a {
      padding: 0.5rem;
    }
    .dot {
      width: 14px;
      height: 14px;
    }
    .label {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spots li,
    .dot,
    .label {
      transition: none;
    }
  }
  figcaption {
    position: absolute;
    right: 0.9rem;
    bottom: 0.7rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-2);
    background: rgba(250, 244, 239, 0.9);
    padding: 0.2em 0.7em;
    border-radius: 999px;
  }
  @media (max-width: 640px) {
    figcaption {
      display: none;
    }
    /* Narrow screens: show the photo at 4:3 frame height and let it scroll sideways.
       The canvas keeps the full 16:9 image, so the dots travel with it. */
    .photo {
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .photo::-webkit-scrollbar {
      display: none;
    }
    .canvas {
      width: calc(100% * 4 / 3);
    }
  }
</style>
