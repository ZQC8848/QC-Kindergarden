---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { stories, bySlug, coverOf, illustrationOf, posterOf, nameOf, sceneByFile, placeName, focusOf } from '../../../lib/content';
import { t, langs, otherLang, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return langs.flatMap((lang) => stories.map((st) => ({ params: { lang, slug: st.slug } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const st = stories.find((x) => x.slug === slug)!;
const s = t(lang);
const explicitCover = coverOf(st.slug);
const illustrations = st.illustrations
  .map((panel) => ({ panel, image: illustrationOf(st.slug, panel) }))
  .filter((item) => item.image);
const cover = explicitCover ?? illustrations[0]?.image;
const inlineIllustrations = explicitCover ? illustrations : illustrations.slice(1);
const storyPlaces = st.locations.map((f) => sceneByFile[f]).filter(Boolean);
---

<Base lang={lang} title={`${st.title} · ${s.siteName}`} description={st.excerpt} altPath={`/${otherLang(lang)}/stories/${slug}/`}>
  <article class="story wrap">
    <p class="crumbs"><a href={`/${lang}/#stories`}>{s.storiesTitle}</a></p>
    <p class:list={["kind", `kind-${st.kind}`]}>{st.kind === 'memory' ? s.memoryEvents : s.extraTheater}</p>
    <h1>{st.title}</h1>
    <div class="meta">
      <span>{st.date}</span>
      {storyPlaces.length > 0 && (
        <span class="places">
          {s.location}:
          {storyPlaces.map((p, i) => (
            <>
              <a href={`/${lang}/places/${p.slug}/`}>{placeName(p, lang)}</a>
              {i < storyPlaces.length - 1 && <span class="sep">·</span>}
            </>
          ))}
        </span>
      )}
    </div>
    <div class="cast" aria-label={s.cast}>
      {st.cast.map((cs) => {
        const c = bySlug[cs];
        const p = c && posterOf(cs);
        return (
          c && (
            <a class="member" href={`/${lang}/characters/${cs}/`} style={`--accent:${c.accent};`}>
              {p && <Image src={p} alt="" width={96} loading="lazy" style={`object-position:${focusOf(c, 'avatar')};`} />}
              <span>{nameOf(c, lang)}</span>
            </a>
          )
        );
      })}
    </div>
    {cover && (
      <figure class="cover">
        <Image src={cover} alt="" widths={[720, 1200, 1600]} sizes="(max-width: 1000px) 100vw, 960px" loading="eager" />
      </figure>
    )}
    {lang === 'en' && <p class="notice">{s.notTranslated}</p>}
    {st.kind === 'extra' && <p class="notice extra-notice">{st.framing || s.extraNotice}</p>}
    <div class="prose text" set:html={st.html} />

    {inlineIllustrations.length > 0 && (
      <section class="illustration-section" aria-labelledby="story-illustrations">
        <h2 id="story-illustrations">{s.storyIllustrations}</h2>
        <div class="illustration-list">
          {inlineIllustrations.map(({ panel, image }) => (
            <figure>
              <Image src={image!} alt={`${s.illustration} ${panel}`} widths={[720, 1200, 1600]} sizes="(max-width: 1000px) 100vw, 960px" loading="lazy" />
              <figcaption>{s.illustration} {panel}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    {st.kind === 'memory' && st.memories.length > 0 && (
      <section class="memory-section">
        <header>
          <h2>{s.memories}</h2>
          <p>{s.memoriesSub}</p>
        </header>
        <div class="memory-list">
          {st.memories.map((memory) => {
            const c = bySlug[memory.character];
            const poster = c && posterOf(memory.character);
            return c && (
              <article class="memory" style={`--memory-accent:${c.accent};`}>
                <a class="memory-person" href={`/${lang}/characters/${c.slug}/`} aria-label={nameOf(c, lang)}>
                  {poster && <Image src={poster} alt="" width={128} loading="lazy" style={`object-position:${focusOf(c, 'avatar')};`} />}
                  <div>
                    <h3>{nameOf(c, lang)}</h3>
                    <span>{s.knowledge[memory.knowledge]}</span>
                  </div>
                </a>
                <div class="memory-copy">
                  <h3>“{memory.title}”</h3>
                  <p>{memory.summary}</p>
                  {memory.impact && <p class="impact">{memory.impact}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .story {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    max-width: 960px;
  }
  .crumbs {
    font-weight: 700;
    color: var(--ink-2);
    margin-bottom: 0.5rem;
  }
  .kind {
    margin-bottom: 0.45rem;
    color: var(--accent-ink);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.03em;
  }
  .kind-extra { color: var(--ink-2); }
  .meta {
    margin-top: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    color: var(--ink-2);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .meta .places {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }
  .meta .places a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in srgb, var(--ink) 35%, transparent);
  }
  .meta .places a:hover {
    text-decoration-color: currentColor;
  }
  .meta .sep {
    color: var(--ink-3);
  }
  .cast {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .member {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.8rem 0.25rem 0.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, var(--panel));
    font-weight: 800;
    font-size: 0.9rem;
  }
  .member img {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .cover {
    margin: 2rem 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .notice {
    margin: 1.5rem 0;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent) 12%, var(--panel));
    color: var(--accent-ink);
    font-weight: 700;
  }
  .extra-notice {
    border-left: 4px solid var(--accent);
  }
  .text {
    margin-top: 2rem;
    font-size: 1.08rem;
    line-height: 1.9;
  }
  .text :global(h2),
  .text :global(h3) {
    margin: 2em 0 0.8em;
  }
  .text :global(hr) {
    margin: 2.2em 0;
  }
  .illustration-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line-strong);
  }
  .illustration-list {
    margin-top: 1.25rem;
    display: grid;
    gap: 1.5rem;
  }
  .illustration-list figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow-sm);
  }
  .illustration-list img {
    width: 100%;
    height: auto;
    display: block;
  }
  .illustration-list figcaption {
    padding: 0.65rem 1rem;
    color: var(--ink-3);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .memory-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line-strong);
  }
  .memory-section > header p {
    color: var(--ink-2);
    margin-top: 0.5rem;
  }
  .memory-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  .memory {
    position: relative;
    display: grid;
    grid-template-columns: minmax(170px, 2fr) minmax(0, 5fr);
    gap: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--memory-accent) 10%, var(--panel));
    transition: background 0.2s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
  }
  /* The whole card links to the character: the person block is the link and its ::after stretches over the card. */
  .memory:has(.memory-person:hover),
  .memory:has(.memory-person:focus-visible) {
    background: color-mix(in srgb, var(--memory-accent) 18%, var(--panel));
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }
  .memory:has(.memory-person:focus-visible) {
    outline: 2px solid var(--memory-accent);
    outline-offset: 2px;
  }
  .memory-person {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: inherit;
    text-decoration: none;
    outline: none;
  }
  .memory-person::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .memory-person:hover h3 {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  @media (prefers-reduced-motion: reduce) {
    .memory {
      transition: none;
    }
    .memory:has(.memory-person:hover) {
      transform: none;
    }
  }
  .memory-person img {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .memory-person span {
    color: var(--ink-2);
    font-size: 0.8rem;
    font-weight: 800;
  }
  .memory-copy p {
    color: var(--ink-2);
    margin-top: 0.45rem;
  }
  .memory-copy .impact {
    color: var(--ink);
    font-weight: 700;
  }
  @media (max-width: 680px) {
    .memory { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
