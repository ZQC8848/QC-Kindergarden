---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import { stories, bySlug, coverOf, posterOf, nameOf, sceneMeta } from '../../../lib/content';
import { t, langs, otherLang, type Lang } from '../../../i18n';

export function getStaticPaths() {
  return langs.flatMap((lang) => stories.map((st) => ({ params: { lang, slug: st.slug } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug as string;
const st = stories.find((x) => x.slug === slug)!;
const s = t(lang);
const cover = coverOf(st.slug);
const place = sceneMeta.find((r) => r.file === st.location);
---

<Base lang={lang} title={`${st.title} · ${s.siteName}`} description={st.excerpt} altPath={`/${otherLang(lang)}/stories/${slug}/`}>
  <article class="story wrap">
    <p class="crumbs"><a href={`/${lang}/#stories`}>{s.storiesTitle}</a></p>
    <p class:list={["kind", `kind-${st.kind}`]}>{st.kind === 'memory' ? s.memoryEvents : s.extraTheater}</p>
    <h1>{st.title}</h1>
    <div class="meta">
      <span>{st.date}</span>
      {place && <span>{s.location}: {lang === 'en' ? place.en : place.zh}</span>}
    </div>
    <div class="cast" aria-label={s.cast}>
      {st.cast.map((cs) => {
        const c = bySlug[cs];
        const p = c && posterOf(cs);
        return (
          c && (
            <a class="member" href={`/${lang}/characters/${cs}/`} style={`--accent:${c.accent};`}>
              {p && <Image src={p} alt="" width={80} height={80} loading="lazy" />}
              <span>{nameOf(c, lang)}</span>
            </a>
          )
        );
      })}
    </div>
    {cover && (
      <figure class="cover">
        <Image src={cover} alt="" widths={[720, 1200, 1600]} sizes="(max-width: 1000px) 100vw, 960px" loading="eager" />
      </figure>
    )}
    {lang === 'en' && <p class="notice">{s.notTranslated}</p>}
    {st.kind === 'extra' && <p class="notice extra-notice">{st.framing || s.extraNotice}</p>}
    <div class="prose text" set:html={st.html} />

    {st.kind === 'memory' && st.memories.length > 0 && (
      <section class="memory-section">
        <header>
          <h2>{s.memories}</h2>
          <p>{s.memoriesSub}</p>
        </header>
        <div class="memory-list">
          {st.memories.map((memory) => {
            const c = bySlug[memory.character];
            const poster = c && posterOf(memory.character);
            return c && (
              <article class="memory" style={`--memory-accent:${c.accent};`}>
                <div class="memory-person">
                  {poster && <Image src={poster} alt="" width={96} height={96} loading="lazy" />}
                  <div>
                    <h3>{nameOf(c, lang)}</h3>
                    <span>{s.knowledge[memory.knowledge]}</span>
                  </div>
                </div>
                <div class="memory-copy">
                  <h3>“{memory.title}”</h3>
                  <p>{memory.summary}</p>
                  {memory.impact && <p class="impact">{memory.impact}</p>}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .story {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    max-width: 960px;
  }
  .crumbs {
    font-weight: 700;
    color: var(--ink-2);
    margin-bottom: 0.5rem;
  }
  .kind {
    margin-bottom: 0.45rem;
    color: var(--accent-ink);
    font-size: 0.8rem;
    font-weight: 900;
    letter-spacing: 0.03em;
  }
  .kind-extra { color: var(--ink-2); }
  .meta {
    margin-top: 0.8rem;
    display: flex;
    gap: 1.25rem;
    color: var(--ink-2);
    font-weight: 700;
    font-size: 0.95rem;
  }
  .cast {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .member {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.8rem 0.25rem 0.25rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 14%, var(--panel));
    font-weight: 800;
    font-size: 0.9rem;
  }
  .member img {
    width: 30px;
    height: 30px;
    border-radius: 999px;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .cover {
    margin: 2rem 0;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .notice {
    margin: 1.5rem 0;
    padding: 0.7rem 1rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--accent) 12%, var(--panel));
    color: var(--accent-ink);
    font-weight: 700;
  }
  .extra-notice {
    border-left: 4px solid var(--accent);
  }
  .text {
    margin-top: 2rem;
    font-size: 1.08rem;
    line-height: 1.9;
  }
  .text :global(h2),
  .text :global(h3) {
    margin: 2em 0 0.8em;
  }
  .text :global(hr) {
    margin: 2.2em 0;
  }
  .memory-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--line-strong);
  }
  .memory-section > header p {
    color: var(--ink-2);
    margin-top: 0.5rem;
  }
  .memory-list {
    margin-top: 1.5rem;
    display: grid;
    gap: 1rem;
  }
  .memory {
    display: grid;
    grid-template-columns: minmax(170px, 2fr) minmax(0, 5fr);
    gap: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--memory-accent) 10%, var(--panel));
  }
  .memory-person {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .memory-person img {
    width: 54px;
    height: 54px;
    border-radius: 999px;
    object-fit: cover;
    object-position: 50% 15%;
  }
  .memory-person span {
    color: var(--ink-2);
    font-size: 0.8rem;
    font-weight: 800;
  }
  .memory-copy p {
    color: var(--ink-2);
    margin-top: 0.45rem;
  }
  .memory-copy .impact {
    color: var(--ink);
    font-weight: 700;
  }
  @media (max-width: 680px) {
    .memory { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
