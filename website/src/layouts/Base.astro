---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import '../styles/global.css';
import { t, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  accent?: string;
  accentInk?: string;
  /** path of this page in the other language, e.g. /en/characters/haide/ */
  altPath?: string;
  /** the page's lead image, used as the share card; falls back to the group photo */
  image?: ImageMetadata;
  /** alt text for that image, also the card's image description */
  imageAlt?: string;
}

const { lang, title, description, accent, accentInk, altPath, image, imageAlt } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
const switchHref = altPath ?? `/${other}/`;
const home = `/${lang}/`;
const style = accent ? `--accent:${accent};--accent-ink:${accentInk ?? accent};` : undefined;

// Share cards. The discord-notify skill posts these links into Discord, and without this
// block they unfurled as bare URLs — no title, no image, no summary.
// Absolute URLs are required: scrapers do not resolve relative paths.
const abs = (p: string) => new URL(p, Astro.site).href;
const canonical = abs(Astro.url.pathname);
// Width is capped at the source's own so nothing is upscaled; height is derived from the
// source ratio rather than read back off the result, which keeps the two og:image
// dimensions consistent with each other whatever the image service returns.
const shareWidth = image ? Math.min(1200, image.width) : 0;
const shareHeight = image ? Math.round((shareWidth * image.height) / image.width) : 0;
const shareImage = image ? await getImage({ src: image, width: shareWidth, format: 'webp' }) : null;
---

<html lang={lang === 'zh' ? 'zh-CN' : 'en'} style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" href="/fonts/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={abs(switchHref)} />
    <link rel="alternate" hreflang="x-default" href={abs(`/zh${Astro.url.pathname.slice(3)}`)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={s.siteName} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    {shareImage && (
      <>
        <meta property="og:image" content={abs(shareImage.src)} />
        <meta property="og:image:width" content={String(shareWidth)} />
        <meta property="og:image:height" content={String(shareHeight)} />
        <meta property="og:image:alt" content={imageAlt ?? title} />
      </>
    )}
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={home}>
          {s.siteName}
        </a>
        <nav aria-label="primary">
          <a href={`${home}#characters`}>{s.nav.characters}</a>
          <a href={`${home}#stories`}>{s.nav.stories}</a>
          <a href={`${home}#places`}>{s.nav.places}</a>
        </nav>
        <a class="lang" href={switchHref} lang={other === 'zh' ? 'zh-CN' : 'en'}>
          {s.switchLang}
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <script>
      // Reveal-on-scroll for .reveal elements. IntersectionObserver is the primary trigger;
      // a rect check on scroll/resize/load is the fallback so nothing can stay invisible.
      const pending = new Set<HTMLElement>(document.querySelectorAll<HTMLElement>('.reveal'));
      const show = (el: HTMLElement) => {
        el.classList.add('is-in');
        pending.delete(el);
      };
      const inView = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        return r.bottom > 0 && r.top < window.innerHeight * 0.92;
      };
      let queued = false;
      const check = () => {
        queued = false;
        pending.forEach((el) => inView(el) && show(el));
        if (pending.size === 0) {
          window.removeEventListener('scroll', schedule);
          window.removeEventListener('resize', schedule);
        }
      };
      const schedule = () => {
        if (!queued) {
          queued = true;
          // setTimeout rather than requestAnimationFrame: rAF is paused in background tabs.
          setTimeout(check, 40);
        }
      };
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                show(entry.target as HTMLElement);
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
        );
        pending.forEach((el) => io.observe(el));
      }
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      window.addEventListener('load', schedule);
      check();
    </script>
    <footer class="footer">
      <div class="wrap footer-inner">
        <p>
          {s.siteName}. {s.footer}
        </p>
        <nav class="footer-links" aria-label="links">
          <a href="https://github.com/ZQC8848/QC-Kindergarten" rel="noopener">
            GitHub
          </a>
          {/* Small easter egg: the author's site only shows up on the English side. */}
          {lang === 'en' && (
            <a href="https://qinchuan.vercel.app/" rel="noopener author">
              {s.author}
            </a>
          )}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-weight: 700;
    color: var(--ink-2);
  }
  nav a:hover {
    color: var(--ink);
  }
  .lang {
    font-weight: 800;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    border: 2px solid var(--line-strong);
  }
  .lang:hover {
    border-color: var(--ink);
  }
  @media (max-width: 640px) {
    nav {
      display: none;
    }
  }
  .footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 2rem 0 3rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
  }
  .footer a {
    font-weight: 700;
    color: var(--ink);
  }
</style>
