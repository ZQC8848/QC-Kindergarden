---
import '../styles/global.css';
import { t, otherLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  accent?: string;
  accentInk?: string;
  /** path of this page in the other language, e.g. /en/characters/haide/ */
  altPath?: string;
}

const { lang, title, description, accent, accentInk, altPath } = Astro.props;
const s = t(lang);
const other = otherLang(lang);
const switchHref = altPath ?? `/${other}/`;
const home = `/${lang}/`;
const style = accent ? `--accent:${accent};--accent-ink:${accentInk ?? accent};` : undefined;
---

<html lang={lang === 'zh' ? 'zh-CN' : 'en'} style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="preload" href="/fonts/nunito-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" hreflang={other} href={switchHref} />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href={home}>{s.siteName}</a>
        <nav aria-label="primary">
          <a href={`${home}#characters`}>{s.nav.characters}</a>
          <a href={`${home}#stories`}>{s.nav.stories}</a>
          <a href={`${home}#places`}>{s.nav.places}</a>
        </nav>
        <a class="lang" href={switchHref} lang={other === 'zh' ? 'zh-CN' : 'en'}>{s.switchLang}</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p>{s.siteName}. {s.footer}</p>
        <nav class="footer-links" aria-label="links">
          <a href="https://github.com/ZQC8848/QC-Kindergarten" rel="noopener">GitHub</a>
          {/* Small easter egg: the author's site only shows up on the English side. */}
          {lang === 'en' && <a href="https://qinchuan.vercel.app/" rel="noopener author">{s.author}</a>}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--nav-h);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .brand {
    font-weight: 900;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    margin-right: auto;
  }
  nav {
    display: flex;
    gap: 1.25rem;
    font-weight: 700;
    color: var(--ink-2);
  }
  nav a:hover {
    color: var(--ink);
  }
  .lang {
    font-weight: 800;
    padding: 0.3em 0.9em;
    border-radius: 999px;
    border: 2px solid var(--line-strong);
  }
  .lang:hover {
    border-color: var(--ink);
  }
  @media (max-width: 640px) {
    nav {
      display: none;
    }
  }
  .footer {
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 2rem 0 3rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
  }
  .footer a {
    font-weight: 700;
    color: var(--ink);
  }
</style>
