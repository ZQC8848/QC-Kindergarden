# Two agents and two editors work on this repo; without this they disagree about
# indentation and line endings on every file they both touch.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# trailing spaces are a hard line break in markdown
trim_trailing_whitespace = false

[*.{png,jpg,jpeg,webp,ico,woff2,glb}]
insert_final_newline = false
trim_trailing_whitespace = false
